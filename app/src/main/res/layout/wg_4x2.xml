<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_bg" android:padding="10dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextClock android:id="@+id/w_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="H:mm" android:format12Hour="h:mm" android:textColor="#FFFFFFFF" android:textSize="32sp" android:textStyle="bold" /><TextClock android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="EEEE, d MMMM" android:format12Hour="EEEE, d MMMM" android:textColor="#FFFFFFFF" android:textSize="12sp" /><TextView android:id="@+id/w_alarm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" /></LinearLayout>
<ImageView android:id="@+id/w_icon" android:layout_width="42dp" android:layout_height="42dp" android:scaleType="fitCenter" /><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
<TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="28sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" /><TextView android:id="@+id/w_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" /><TextView android:id="@+id/w_place" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" /></LinearLayout></LinearLayout><LinearLayout android:id="@+id/w_days" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="6dp" />
</LinearLayout>
