<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center" android:background="@drawable/widget_bg" android:padding="10dp">
<ImageView android:id="@+id/a_icon" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="fitCenter" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
<TextView android:id="@+id/a_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="26sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" /><TextView android:id="@+id/a_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" /></LinearLayout>
<TextView android:id="@+id/a_nap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Drzemka\n20 min" android:gravity="center" android:textColor="#FFFFFFFF" android:textSize="11sp" android:background="@drawable/widget_btn" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" />
</LinearLayout>
