<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/r_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:id="@+id/r_icon" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" />
    <TextView android:id="@+id/r_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="30sp" android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:layout_marginStart="6dp" android:shadowColor="#66000000" android:shadowRadius="6" android:shadowDy="1" />
    <TextView android:id="@+id/r_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="8dp" android:shadowColor="#66000000" android:shadowRadius="6" android:shadowDy="1" />
</LinearLayout>
