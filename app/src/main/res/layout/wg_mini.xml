<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="8dp">
    <TextClock android:id="@+id/w_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format24Hour="H:mm" android:format12Hour="h:mm" android:textColor="#FFFFFFFF" android:textSize="88sp"
        android:fontFamily="sans-serif-thin" android:includeFontPadding="false" android:shadowColor="#99000000" android:shadowRadius="10" android:shadowDy="2" />
    <TextClock android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format24Hour="EEEE, d MMMM" android:format12Hour="EEEE, d MMMM" android:textColor="#FFFFFFFF" android:textSize="16sp"
        android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp" android:shadowColor="#99000000" android:shadowRadius="10" android:shadowDy="2" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginTop="10dp">
        <ImageView android:id="@+id/w_icon" android:layout_width="34dp" android:layout_height="34dp" android:scaleType="fitCenter" />
        <TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF"
            android:textSize="22sp" android:fontFamily="sans-serif-light" android:layout_marginStart="6dp" android:includeFontPadding="false" android:shadowColor="#99000000" android:shadowRadius="10" android:shadowDy="2" />
        <TextView android:id="@+id/w_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF"
            android:textSize="15sp" android:maxLines="1" android:layout_marginStart="8dp" android:shadowColor="#99000000" android:shadowRadius="10" android:shadowDy="2" />
    </LinearLayout>
    <TextView android:id="@+id/w_now" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E6FFFFFF"
        android:textSize="13sp" android:maxLines="1" android:layout_marginTop="4dp" android:shadowColor="#99000000" android:shadowRadius="10" android:shadowDy="2" />
</LinearLayout>
